)

update weight for ivisaur to 90

db.pokemon.updateOne(
  { pokemon_name: "ivisaur" },
  { $set: { weight: 90 } }
)

rename pokemon_id to id

db.pokemon.updateMany(
  {},
  { $rename: { "pokemon_id": "id" } }
)

order by acending order by id

